# Rails
RAILS_ENV=development
RAILS_MAX_THREADS=5
PORT=3000
RAILS_LOG_LEVEL=info
# Set to "1" to run Solid Queue inside Puma.
SOLID_QUEUE_IN_PUMA=0

# PostgreSQL
DB_HOST=localhost
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=backend_development

# Optional database port
DB_PORT=5432

# MinIO/S3-compatible evidence storage
EVIDENCE_BUCKET=traffic-evidence
S3_ENDPOINT=http://localhost:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# JWT
DEVISE_JWT_SECRET_KEY=very-long-secret-key-used-for-jwt


# First admin generation
ADMIN_NAME=admin
ADMIN_BADGE_NUMBER=admin_101
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=strong-password

# Stream
MEDIAMTX_PLAYBACK_BASE=http://localhost:8889
MEDIAMTX_HLS_BASE=http://localhost:8888
# Base URL for the external signal-state generator, if deployed.
SIGNAL_STATE_BASE_URL=http://localhost:5001