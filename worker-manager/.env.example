# Previous A/B/C deployment pattern, kept here for reference (inactive):
# BACKEND_URL=http://<DEVICE_A_IP>:3000
# MEDIAMTX_URL=rtsp://<DEVICE_B_IP>:8554
# VIDEO_PUBLISH_URL=rtsp://127.0.0.1:8554
# MEDIAMTX_HOST=<DEVICE_B_IP>
# VIDEO_SSH_TARGET=<ssh-user>@<DEVICE_B_IP>
# VIDEO_SSH_MODE=powershell
# VIDEO_DIR_ON_B=/absolute/path/to/traffic-violation-detection/infrastructure/media/videos
# ADVERTISE_HOST=<DEVICE_C_IP>
# WORKER_SSH_TARGET=<ssh-user>@<DEVICE_C_IP>
# WORKER_BUILD_CONTEXT_ON_C=/absolute/path/to/repo/worker
# MODEL_DIR_ON_C=/absolute/path/to/model-weights

# Current setup: backend and manager in WSL on Windows .5; MediaMTX,
# MinIO, frontend, and videos on Linux .9; worker container via local
# Docker Desktop engine from WSL.
BACKEND_URL=http://192.168.1.5:3000
MEDIAMTX_URL=rtsp://user:mediamtx@192.168.1.9:8554
VIDEO_PUBLISH_URL=rtsp://user:mediamtx@127.0.0.1:8554
MEDIAMTX_HOST=192.168.1.9
VIDEO_SSH_TARGET=safal@192.168.1.9
VIDEO_SSH_MODE=linux-docker
VIDEO_DIR_ON_B=/home/safal/Projects/6-sem/traffic-violation-detection/infrastructure/media/videos
ADVERTISE_HOST=192.168.1.5
WORKER_SSH_TARGET=
WORKER_DOCKER_NETWORK=bridge
WORKER_DEVICE=cpu
WORKER_GPU=0
WORKER_REQUIREMENTS=requirements-cpu.txt
# Opt in only when the worker host has NVIDIA Container Toolkit configured:
# WORKER_GPU=1
# WORKER_REQUIREMENTS=requirements-gpu.txt
# WORKER_DEVICE=0
# WORKER_IMAGE=traffic-worker:demo-gpu

# Local build/model paths on the WSL manager host.
VIDEO_DIR=../infrastructure/media/videos
WORKER_BUILD_CONTEXT=../worker
MODEL_DIR=../worker

# Shared secret keys (must match the backend configuration).
WORKER_MANAGER_KEY=your-shared-manager-key
WORKER_API_KEY=your-shared-worker-key
SIGNAL_CONTROL_TOKEN=your-shared-signal-token

# MediaMTX API account is distinct from the RTSP user above.
MEDIAMTX_API_USER=worker
MEDIAMTX_API_PASS=change-this-to-the-MediaMTX-worker-password

# Worker runtime options.
WORKER_IMAGE=traffic-worker:demo-cpu
POLL_SECONDS=5
CONTROL_PORT_START=8081
SIGNAL_PORT_START=5001
