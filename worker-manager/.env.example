# 1. Device A (Backend Laptop)
BACKEND_URL="http://<DEVICE_A_IP>:3000"

# 2. Device B (Frontend, videos, MediaMTX)
MEDIAMTX_URL="rtsp://<DEVICE_B_IP>:8554"
VIDEO_PUBLISH_URL="rtsp://127.0.0.1:8554"
MEDIAMTX_HOST="<DEVICE_B_IP>"
VIDEO_SSH_TARGET="<ssh-user>@<DEVICE_B_IP>"
VIDEO_DIR_ON_B="/absolute/path/to/traffic-violation-detection/infrastructure/media/videos"

# 3. Device C (This Worker Laptop)
ADVERTISE_HOST="<DEVICE_C_IP>"
WORKER_SSH_TARGET="<ssh-user>@<DEVICE_C_IP>"
WORKER_BUILD_CONTEXT_ON_C="/absolute/path/to/traffic-violation-detection/worker"
MODEL_DIR_ON_C="/absolute/path/to/model-weights"

# 4. Local File Paths on Device C
# Optional local/single-host fallback only; use the remote values above for A/B/C.
VIDEO_DIR="../infrastructure/media/videos"
WORKER_BUILD_CONTEXT="../worker"
MODEL_DIR="../worker"

# 5. Shared Secret Keys (Must match values in Device A's Rails config)
WORKER_MANAGER_KEY="your-shared-manager-key"
WORKER_API_KEY="your-shared-worker-key"
SIGNAL_CONTROL_TOKEN="your-shared-signal-token"
MEDIAMTX_API_USER="worker"
MEDIAMTX_API_PASS="change-this-to-the-MediaMTX-worker-password"

# 6. Worker Runtime Options
WORKER_IMAGE="traffic-worker:demo"
POLL_SECONDS=5
CONTROL_PORT_START=8081
SIGNAL_PORT_START=5001
